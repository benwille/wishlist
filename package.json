{
  "name": "wishlist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:worker": "opennextjs-cloudflare build",
    "preview": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply wishlist --local",
    "db:migrate:remote": "wrangler d1 migrations apply wishlist --remote",
    "postinstall": "sh scripts/postinstall.sh"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.18.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.2",
    "mimetext": "^3.0.28",
    "next": "16.2.2",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20260408.1",
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.81.0"
  }
}
